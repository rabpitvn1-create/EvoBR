{
  "name": "evobr",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci:e2e": "npm run test:e2e",
    "check:required-tables": "node scripts/check-required-tables.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:ai-manual": "node scripts/generate-ai-manual.mjs --check",
    "ci": "npm run check:architecture && npm run check:dependencies && npm run check:ai-entry-registry && npm run check:required-tables && npm run check:ai-manual && npm run typecheck && npm run test:codex-bridge && npm test && npm run build",
    "gen:ai-manual": "node scripts/generate-ai-manual.mjs",
    "test:codex-bridge": "node --test scripts/local-codex/*.test.mjs",
    "check:ai-entry-registry": "node scripts/check-ai-entry-registry.mjs",
    "gen:dependencies": "node scripts/inspect-longform-dependencies.mjs",
    "check:dependencies": "node scripts/inspect-longform-dependencies.mjs --check"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@noble/hashes": "2.4.0",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-text-style": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "d3-hierarchy": "^3.1.2",
    "delaunator": "^5.1.0",
    "dexie": "^4.0.11",
    "hash-wasm": "4.12.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.2",
    "marked": "^15.0.12",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-router": "^8.3.0",
    "turndown": "^7.2.0",
    "yaml": "^2.4.5",
    "zustand": "^5.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "@types/d3-hierarchy": "^3.1.7"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
